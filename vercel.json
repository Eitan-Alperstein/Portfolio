{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tracker.eitanalperstein.com"
        }
      ],
      "destination": "https://www.eitanalperstein.com/daily-tracker",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "parkour.eitanalperstein.com"
        }
      ],
      "destination": "https://www.eitanalperstein.com/arduino-parkour",
      "permanent": false
    },
    {
      "source": "/projects.html",
      "destination": "/#code",
      "permanent": false
    },
    {
      "source": "/projects",
      "destination": "/#code",
      "permanent": false
    }
  ]
}
