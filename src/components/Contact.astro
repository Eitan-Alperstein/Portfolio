---
import { EMAIL, LINKEDIN_URL, GITHUB_URL } from "../data/site";
import Arrow from "./Arrow.astro";
---
<section id="contact" class="wrap">
  <div class="box" data-reveal>
    <p class="eyebrow">Contact</p>
    <h2 class="title">Want to build something, or just talk about it?</h2>
    <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <div class="links">
      <a class="link-arrow" href={GITHUB_URL} target="_blank" rel="noopener">GitHub <Arrow /></a>
      {LINKEDIN_URL && <a class="link-arrow" href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn <Arrow /></a>}
    </div>
  </div>
</section>

<footer class="wrap">
  <span>© {new Date().getFullYear()} Eitan Alperstein</span>
  <span>Built with Astro. The background is a live Voronoi diagram.</span>
</footer>

<style>
  .box {
    position: relative; overflow: hidden;
    border: 1px solid var(--line); border-radius: 24px; padding: 64px;
    background:
      radial-gradient(60% 90% at 100% 0%, rgba(159,177,255,0.12), transparent 60%),
      var(--bg-raised);
  }
  .email {
    display: inline-block; margin-top: 30px;
    font-size: clamp(22px, 4vw, 40px); font-weight: 600; letter-spacing: -0.03em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size .4s, color .2s; padding-bottom: 4px; overflow-wrap: anywhere;
  }
  .email:hover { color: var(--accent); background-size: 100% 1px; }
  .links { display: flex; gap: 26px; margin-top: 30px; }
  footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-top: 48px; padding-bottom: 48px; color: var(--muted); font-size: 13.5px;
  }
  @media (max-width: 640px) { .box { padding: 36px 22px; border-radius: 18px; } }
</style>
