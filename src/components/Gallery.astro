---
// Shows the images `npm run shots` put in public/shots/<slug>/, or a
// "coming soon" placeholder when the folder is empty.
import { listShots } from "../lib/shots";
import ComingSoon from "./ComingSoon.astro";

interface Props { slug: string; alt: string; empty?: string; hint?: string }
const { slug, alt, empty = "Screenshots coming soon.", hint } = Astro.props;
const images = listShots(slug);
---
{images.length > 0 ? (
  <div class="gallery">
    {images.map((src, i) => (
      <a href={src} target="_blank" rel="noopener">
        <img src={src} alt={`${alt}, ${i + 1} of ${images.length}`} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
) : (
  <ComingSoon label={empty} hint={hint} />
)}

<style>
  .gallery { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .gallery a { display: block; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); transition: border-color .2s, transform .2s; }
  .gallery a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .gallery img { width: 100%; height: auto; display: block; }
</style>
