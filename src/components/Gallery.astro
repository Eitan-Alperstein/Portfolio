---
// Lists whatever images `npm run shots` put in public/shots/<slug>/.
import fs from "node:fs";
import path from "node:path";

interface Props { slug: string; alt: string }
const { slug, alt } = Astro.props;
const dir = path.join(process.cwd(), "public", "shots", slug);
const images = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp|avif|gif)$/i.test(f)).sort()
  : [];
---
{images.length > 0 ? (
  <div class="gallery">
    {images.map((f, i) => (
      <a href={`/shots/${slug}/${f}`} target="_blank" rel="noopener">
        <img src={`/shots/${slug}/${f}`} alt={`${alt}, screenshot ${i + 1}`} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
) : (
  <div class="empty">
    <div class="frames" aria-hidden="true"><span></span><span></span><span></span></div>
    <p>Screenshots coming soon.</p>
  </div>
)}

<style>
  .gallery { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .gallery a { display: block; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); transition: border-color .2s, transform .2s; }
  .gallery a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .gallery img { width: 100%; height: auto; display: block; }
  .empty {
    border: 1px dashed var(--line-strong); border-radius: var(--radius);
    padding: 44px 24px; display: grid; justify-items: center; gap: 18px; text-align: center;
    background: var(--bg-raised);
  }
  .empty p { margin: 0; color: var(--muted); font: 400 13px/1.5 var(--mono); }
  .frames { display: flex; gap: 10px; }
  .frames span {
    width: 92px; aspect-ratio: 16 / 10; border-radius: 8px; border: 1px solid var(--line-strong);
    background: linear-gradient(110deg, var(--surface) 30%, rgba(159,177,255,0.08) 50%, var(--surface) 70%) 0 0 / 300% 100%;
    animation: shimmer 2.8s infinite linear;
  }
  .frames span:nth-child(2) { animation-delay: .3s; }
  .frames span:nth-child(3) { animation-delay: .6s; }
  @keyframes shimmer { from { background-position: 100% 0; } to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .frames span { animation: none; } }
  @media (max-width: 480px) { .frames span { width: 72px; } }
</style>
