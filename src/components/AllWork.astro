---
import projects from "../data/projects.json";
import Tags from "./Tags.astro";
import Links from "./Links.astro";

const groups = [
  { id: "students", title: "For students", note: "Things I made because I'm a student and wanted them to exist." },
  { id: "mine", title: "Tools I use myself", note: "Built to scratch my own itch: guitar, habits, the gym." },
  { id: "sims", title: "Simulations & experiments", note: "Math and code I wanted to see move." },
];
---
<section id="all" class="wrap">
  <p class="eyebrow" data-reveal>Everything else</p>
  <h2 class="title" data-reveal style="--d: 60ms">All the projects.</h2>
  <p class="title-sub" data-reveal style="--d: 120ms">
    Some are polished, some are weekend experiments. Code is linked when the repo is public.
  </p>

  <div class="groups">
    {groups.map((g) => (
      <div class="group" data-reveal>
        <div class="head">
          <h3>{g.title}</h3>
          <p>{g.note}</p>
        </div>
        <ul>
          {projects.filter((p) => p.group === g.id).map((p) => (
            <li>
              <div class="name">
                <span>{p.title}</span>
                <Tags stack={p.stack} ai={p.ai} limit={3} />
              </div>
              <p class="blurb">{p.blurb}</p>
              <Links title={p.title} url={p.url} repo={p.repo} showPrivate />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .groups { display: grid; gap: 56px; margin-top: 56px; }
  .group { display: grid; grid-template-columns: 260px 1fr; gap: 40px; }
  .head h3 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
  .head p { margin: 8px 0 0; color: var(--muted); font-size: 14.5px; }
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li {
    display: grid; grid-template-columns: 230px 1fr auto; gap: 24px; align-items: baseline;
    padding: 20px 8px; border-bottom: 1px solid var(--line);
    transition: background .25s;
  }
  li:hover { background: linear-gradient(90deg, var(--accent-soft), transparent 70%); }
  .name { display: flex; flex-direction: column; gap: 8px; }
  .name > span { font-weight: 600; font-size: 16px; }
  .blurb { margin: 0; color: var(--ink-soft); font-size: 15px; }
  @media (max-width: 960px) {
    .group { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 720px) {
    li { grid-template-columns: 1fr; gap: 10px; padding: 18px 4px; }
  }
</style>
